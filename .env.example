# ==============================================================================
# Multi-Hospital Post-Discharge Outreach Platform — Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Database Configuration
# Local SQLite (Default, Zero setup): sqlite:///./healthcare_platform.db
# Production PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/healthcare_platform
DATABASE_URL=sqlite:///./healthcare_platform.db

# JWT Authentication
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Operational Defaults
DEFAULT_CALLING_START_HOUR=8
DEFAULT_CALLING_END_HOUR=20
DEFAULT_MAX_RETRIES=3
DEFAULT_HOSPITAL_CAPACITY=10

# AI Provider Configuration
# Options: mock_local (offline clinical heuristics & rules), openai, gemini
AI_PROVIDER=mock_local
OPENAI_API_KEY=
GEMINI_API_KEY=

# CORS (comma-separated origins, or * )
CORS_ORIGINS=*

# Port Bindings
BACKEND_PORT=8000
FRONTEND_PORT=3000
